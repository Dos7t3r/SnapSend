{
  "manifest_version": 3,
  "name": "SnapSend · 课堂照片投递",
  "version": "0.6.1",
  "description": "通过本机 USB 桥接，把绑定课堂的新照片投递到 ChatGPT。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}